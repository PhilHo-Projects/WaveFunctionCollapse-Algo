{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "rootDir": ".",
    "outDir": "Test/.compiled",
    "noEmit": false
  },
  "include": [
    "Test/topology-builder.test.ts",
    "src/core/TopologyBuilder.ts",
    "src/core/TopologyDeformedQuadGrid.ts",
    "src/core/TopologyMeshResolver.ts"
  ]
}
